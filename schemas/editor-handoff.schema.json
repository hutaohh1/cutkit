{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cutkit.local/schemas/editor-handoff.schema.json",
  "title": "CutKit Editor Handoff Manifest",
  "type": "object",
  "required": ["schemaVersion", "handoffId", "timelineId", "baseRevision", "format", "actor", "payloadHash", "locks", "ownership", "status"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "handoffId": { "type": "string", "pattern": "^handoff_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "timelineId": { "type": "string", "pattern": "^timeline_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "baseRevision": { "type": "integer", "minimum": 0 },
    "format": { "enum": ["edl", "fcpxml", "otio-json"] },
    "actor": { "type": "string", "minLength": 1 },
    "payloadHash": { "type": "string", "pattern": "^sha256:" },
    "locks": { "type": "array" },
    "ownership": { "enum": ["external_editor", "cutkit"] },
    "status": { "enum": ["handed_off", "reimported", "closed"] },
    "createdAt": { "type": "integer" },
    "reimportedAt": { "type": "integer" }
  }
}
