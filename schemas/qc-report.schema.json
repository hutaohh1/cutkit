{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cutkit.local/schemas/qc-report.schema.json",
  "title": "CutKit QC Report",
  "type": "object",
  "required": ["schemaVersion", "reportId", "target", "checks", "passed"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reportId": { "type": "string", "pattern": "^report_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "target": { "enum": ["audio", "video", "caption", "render"] },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "status"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pass", "warn", "fail"] },
          "value": {},
          "threshold": {},
          "message": { "type": "string" }
        }
      }
    },
    "passed": { "type": "boolean" }
  }
}
